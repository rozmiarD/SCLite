{
  "$defs": {
    "disclosure": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "coverage": {
          "type": "object"
        },
        "policy": {
          "type": "string"
        },
        "publication_authorized": {
          "const": false
        },
        "status": {
          "enum": [
            "unknown",
            "operator_asserted",
            "checks_performed",
            "externally_verified"
          ]
        }
      },
      "required": [
        "status",
        "checks",
        "policy",
        "coverage",
        "publication_authorized"
      ],
      "type": "object"
    }
  },
  "$id": "https://sclite.local/schemas/redaction_policy.v0.2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type": {
      "const": "redaction_policy"
    },
    "disclosure": {
      "$ref": "#/$defs/disclosure"
    },
    "mode": {
      "minLength": 1,
      "type": "string"
    },
    "non_claims": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "policy_id": {
      "minLength": 1,
      "type": "string"
    },
    "public_safety": {
      "additionalProperties": true,
      "properties": {
        "credentials_included": {
          "enum": [
            "unknown"
          ]
        },
        "private_paths_included": {
          "enum": [
            "unknown"
          ]
        }
      },
      "required": [
        "credentials_included",
        "private_paths_included"
      ],
      "type": "object"
    },
    "rules": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "v0.2"
    }
  },
  "required": [
    "artifact_type",
    "schema_version",
    "policy_id",
    "mode",
    "rules",
    "disclosure",
    "public_safety",
    "non_claims"
  ],
  "title": "SCLite RedactionPolicy v0.2",
  "type": "object"
}
